<div class="show-container">

  <div class="show-card">

    <!-- TITLE -->
    <h1 class="show-title"><%= listing.title %></h1>

    <!-- IMAGE -->
    <div class="show-image">
      <img 
        src="<%= listing.image && listing.image.url 
              ? listing.image.url 
              : 'https://res.cloudinary.com/dzfbgnkd8/image/upload/v1771099002/Listings/wiz5nqn8zlf89vmpwz3i.png' %>" 
        alt="Job image"
      >
    </div>

    <!-- META INFO -->
    <div class="show-meta">

      <!-- WORK TYPE -->
       
    <div class="meta-item">
       <span>🛠️ Work Type</span>
       <p><%= listing.workType %></p  >
    </div>

      <div class="meta-item">
        <span>👤 Posted By</span>
        <p><%= listing.postedBy ? listing.postedBy.username : "Unknown" %></p>
      </div>

      <div class="meta-item">
        <span>📍 Location</span>
        <p>
          <%= listing.location?.area || "" %>
          <%= listing.location?.area ? "," : "" %>
          <%= listing.location?.city || "Not specified" %>
        </p>
      </div>

      <div class="meta-item highlight">
        <span>💰 Wage</span>
        <p>₹<%= listing.wagePerDay %> / day (<%= listing.paymentType %>)</p>
      </div>

      <div class="meta-item">
        <span>👷 Workers required</span>
        <p><%= listing.workersRequired || 1 %></p>
      </div>

      <div class="meta-item">
        <span>📅 Start Date</span>
        <p>
          <%= listing.startDate 
                ? listing.startDate.toDateString() 
                : "Not specified" %>
        </p>
      </div>

    </div>

    <!-- DESCRIPTION -->
    <div class="show-section">
      <h3>Description</h3>
      <p><%= listing.description %></p>
    </div>

    

    <!-- CUSTOM FIELDS -->
    <% if (listing.customFields && listing.customFields.length > 0) { %>
      <div class="show-section">
        <h3>Additional Requirements</h3>

        <% listing.customFields.forEach(field => { %>
          <div class="custom-item">
            <strong><%= field.label %>:</strong>
            <span><%= field.value %></span>
          </div>
        <% }) %>

      </div>
    <% } %>

    <!-- ACTIONS -->
    <div class="show-actions">

      <% if (
        currUser &&
        listing.postedBy &&
        listing.postedBy._id.toString() === currUser._id.toString()
      ) { %>

        <a href="/listings/<%= listing._id %>/edit" class="btn-edit">
          Edit
        </a>

        <form 
          action="/listings/<%= listing._id %>?_method=DELETE"
          method="POST">
          <button class="btn-delete">Delete</button>
        </form>

      <% } %>

      <% if (currUser && currUser.role === "WORKER") { %>
        <form action="/listings/<%= listing._id %>/apply" method="POST">
          <button class="btn-apply">
            Apply for this Job
          </button>
        </form>
      <% } %>

    </div>

  </div>

</div>