<div class="applicants-container">

  <!-- HEADER -->
  <div class="applicants-header">
    <h1>Applicants</h1>

    <div class="job-meta">
      <span><strong>Job:</strong> <%= job.title %></span>
      <span><strong>City:</strong> <%= job.city %></span>
      <span><strong>Work:</strong> <%= job.workType %></span>
      <span><strong>Workers Needed:</strong> <%= job.workersRequired %></span>
    </div>
  </div>

  <% if (!job.applications || job.applications.length === 0) { %>
    <div class="empty-state">
      <p>No workers have applied yet.</p>
    </div>
  <% } else { %>

  <!-- TABLE CARD -->
  <div class="table-card">

    <table class="applicants-table">
      <thead>
        <tr>
          <th>Worker</th>
          <th>Date</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
      </thead>

      <tbody>
        <% job.applications.forEach(app => { %>
          <tr>

            <!-- USER -->
            <td class="worker-cell">
              <a href="/profile/<%= app.applicant._id %>">
                <%= app.applicant.username %>
              </a>
            </td>

            <!-- DATE -->
            <td>
              <%= new Date(app.createdAt).toLocaleDateString() %>
            </td>

            <!-- STATUS -->
            <td>
              <span class="status-badge <%= app.status.toLowerCase() %>">
                <%= app.status %>
              </span>
            </td>

            <!-- ACTION -->
            <td class="actions">

              <% if (app.status === "Applied") { %>

                <form method="POST"
                  action="/listings/<%= job._id %>/applicants/<%= app.applicant._id %>/accept">
                  <button class="btn-accept">Accept</button>
                </form>

                <form method="POST"
                  action="/listings/<%= job._id %>/applicants/<%= app.applicant._id %>/reject">
                  <button class="btn-reject">Reject</button>
                </form>

              <% } else if(app.status==="Accepted"){ %>

                <form method="POST"
                  action="/listings/<%= job._id %>/applicants/<%= app.applicant._id %>/completed">
                  <button class="btn-complete">Complete</button>
                </form>

              <% } %>

            </td>

          </tr>
        <% }) %>
      </tbody>
    </table>

  </div>

  <% } %>

  <!-- BACK -->
  <a class="back-btn" href="/profile">← Back to Profile</a>

</div>