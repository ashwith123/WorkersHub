<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Profile</title>

  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<div class="edit-container">
  <div class="edit-card profile-edit-card">

    <h2 class="edit-title">Edit Profile</h2>

    <form action="/profile/edit" method="POST" enctype="multipart/form-data">

      

      <!-- PROFILE PHOTO -->
      <div class="edit-section">
        <label>Profile Photo</label>

        <div class="profile-photo-edit">
          <img 
            src="<%= user.profilePhoto || '/images/default.png' %>" 
            alt="profile"
          >

          <input 
            type="file" 
            name="profilePhoto" 
            accept="image/*"
            class="form-control"
          >
        </div>
      </div>

      <!-- USERNAME -->
      <div class="edit-section">
        <label>Username</label>
        <input 
          type="text" 
          name="username" 
          class="form-control"
          value="<%= user.username %>" 
          required
        >
      </div>

      <!-- BIO -->
      <div class="edit-section">
        <label>Bio</label>
        <textarea 
          name="bio" 
          rows="4"
          class="form-control"
          placeholder="Tell us about yourself..."
        ><%= user.bio || "" %></textarea>
      </div>

      <!-- SUBMIT -->
      <button type="submit" class="update-btn w-100">
        Save Changes
      </button>

    </form>

  </div>
</div>

</body>
</html>