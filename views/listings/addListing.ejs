<script>
let fieldIndex = 0;

function addField() {
  const container = document.getElementById("customFields");

  const div = document.createElement("div");
  div.className = "row mb-3 align-items-end";

  div.innerHTML = `
    <div class="col-5">
      <label for="customField${fieldIndex}" class="form-label">
        New Field
      </label>
      <input type="text"
             id="customField${fieldIndex}"
             class="form-control"
             name="job[customFields][${fieldIndex}][label]"
             placeholder="e.g. Cement Grade"
             required />
    </div>

    <div class="col-5">
      <label for="customInfo${fieldIndex}" class="form-label">
        Field Information
      </label>
      <input type="text"
             id="customInfo${fieldIndex}"
             class="form-control"
             name="job[customFields][${fieldIndex}][value]"
             placeholder="e.g. 53 Grade"
             required />
    </div>

    <div class="col-2">
      <button type="button"
              class="btn btn-danger w-100"
              onclick="this.closest('.row').remove()">
        Remove
      </button>
    </div>
  `;

  container.appendChild(div);
  fieldIndex++;
}
</script>
<body>
  <div class="col-8 offset-2">
    <br /><br />

    <h1>Create New Job Post</h1>
    <% if (error) { %>
        <div class="alert alert-danger">
        <%= error %>
        </div>
        <% } %>
    <form method="post"
      action="/addListing"
      enctype="multipart/form-data"
      class="needs-validation"
      novalidate>
<!-- Title -->
<div class="mb-3">
  <label for="title" class="form-label">Job Title</label>
  <input id="title" name="job[title]" class="form-control" required />
</div>

<!-- Description -->
<div class="mb-3">
  <label for="description" class="form-label">Work Description</label>
  <textarea id="description"
            name="job[description]"
            class="form-control"
            rows="4"
            required></textarea>
</div>

<!-- Work Type -->
<div class="mb-3">
  <label for="workType" class="form-label">Work Type</label>
  <select id="workType"
          name="job[workType]"
          class="form-select"
          required>
    <option value="">Select</option>
    <option>Masonry</option>
    <option>Plumbing</option>
    <option>Electrical</option>
    <option>Painting</option>
    <option>Carpentry</option>
    <option>Other</option>
  </select>
</div>

<!-- Location -->
<div class="row mb-3">
  <div class="col">
    <label for="city" class="form-label">City</label>
    <input id="city"
           name="job[location][city]"
           class="form-control"
           required />
  </div>

  <div class="col">
    <label for="area" class="form-label">Area</label>
    <input id="area"
           name="job[location][area]"
           class="form-control" />
  </div>
</div>

<!-- Workers -->
<div class="mb-3">
  <label for="workersRequired" class="form-label">
    Workers Required
  </label>
  <input type="number"
         id="workersRequired"
         name="job[workersRequired]"
         class="form-control"
         min="1" />
</div>

<!-- Wage -->
<div class="mb-3">
  <label for="wagePerDay" class="form-label">
    Wage per Day (₹)
  </label>
  <input type="number"
         id="wagePerDay"
         name="job[wagePerDay]"
         class="form-control"
         required />
</div>

<!-- Payment -->
<div class="mb-3">
  <label for="paymentType" class="form-label">
    Payment Type
  </label>
  <select id="paymentType"
          name="job[paymentType]"
          class="form-select"
          required>
    <option>Daily</option>
    <option>Weekly</option>
    <option>Contract</option>
  </select>
</div>

<!-- Start Date -->
<div class="mb-3">
  <label for="startDate" class="form-label">
    Start Date
  </label>
  <input type="date"
         id="startDate"
         name="job[startDate]"
         class="form-control" />
</div>

<!-- Image -->
<div class="mb-3">
  <label for="image" class="form-label">
    Upload Image
  </label>
  <input type="file"
         id="image"
         name="job[image]"
         class="form-control"
         accept="image/*" />
</div>
  <!-- Custom Fields -->
  <hr>
<h5>Additional Requirements (Optional)</h5>
<p class="text-muted">
  Add any extra details specific to this job.
</p>

<div id="customFields"></div>

<button type="button" class="btn btn-secondary" onclick="addField()">
  + Add Requirement
</button>

<div class="mt-4">
  <button type="submit" class="btn btn-dark w-100">
    Create Job Post
  </button>
</div>
</form>
  </div>
</body>