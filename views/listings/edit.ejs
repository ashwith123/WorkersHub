<div class="edit-container">
  <div class="edit-card">

    <h1 class="edit-title">Edit Job Listing</h1>

    <form
      method="POST"
      action="/listings/<%= listing._id %>?_method=PUT"
      class="needs-validation"
      novalidate
    >

      <!-- BASIC -->
      <div class="edit-section">
        <div class="mb-3">
          <label for="title">Job Title</label>
          <input
            type="text"
            id="title"
            name="job[title]"
            class="form-control"
            value="<%= listing.title %>"
            required
          />
        </div>

        <div class="mb-3">
          <label for="description">Description</label>
          <textarea
            id="description"
            name="job[description]"
            class="form-control"
            rows="4"
            required
          ><%= listing.description %></textarea>
        </div>
      </div>

      <!-- WORK TYPE -->
      <div class="edit-section">
        <div class="mb-3">
          <label for="workType">Work Type</label>
          <select
            id="workType"
            name="job[workType]"
            class="form-select"
            required
          >
            <% ["Masonry","Plumbing","Electrical","Painting","Carpentry","Other"].forEach(type => { %>
              <option
                value="<%= type %>"
                <%= listing.workType === type ? "selected" : "" %>
              >
                <%= type %>
              </option>
            <% }) %>
          </select>
        </div>
      </div>

      <!-- LOCATION -->
      <div class="edit-section">
        <div class="row">
          <div class="col-md-6">
            <label for="city">City</label>
            <input
              type="text"
              id="city"
              name="job[location][city]"
              class="form-control"
              value="<%= listing.location?.city || '' %>"
              required
            />
          </div>

          <div class="col-md-6">
            <label for="area">Area</label>
            <input
              type="text"
              id="area"
              name="job[location][area]"
              class="form-control"
              value="<%= listing.location?.area || '' %>"
            />
          </div>
        </div>
      </div>

      <!-- WORKERS -->
      <div class="edit-section">
        <div class="mb-3">
          <label for="workersRequired">Workers Required</label>
          <input
            type="number"
            id="workersRequired"
            name="job[workersRequired]"
            class="form-control"
            value="<%= listing.workersRequired || 1 %>"
            min="1"
          />
        </div>
      </div>

      <!-- PAYMENT -->
      <div class="edit-section">
        <div class="row">
          <div class="col-md-6">
            <label for="wagePerDay">Wage per Day (₹)</label>
            <input
              type="number"
              id="wagePerDay"
              name="job[wagePerDay]"
              class="form-control"
              value="<%= listing.wagePerDay %>"
              min="100"
              required
            />
          </div>

          <div class="col-md-6">
            <label for="paymentType">Payment Type</label>
            <select
              id="paymentType"
              name="job[paymentType]"
              class="form-select"
              required
            >
              <% ["Daily","Weekly","Contract"].forEach(type => { %>
                <option
                  value="<%= type %>"
                  <%= listing.paymentType === type ? "selected" : "" %>
                >
                  <%= type %>
                </option>
              <% }) %>
            </select>
          </div>
        </div>
      </div>

      <!-- START DATE -->
      <div class="edit-section">
        <div class="mb-3">
          <label for="startDate">Start Date</label>
          <input
            type="date"
            id="startDate"
            name="job[startDate]"
            class="form-control"
            value="<%= listing.startDate 
              ? listing.startDate.toISOString().split('T')[0] 
              : '' %>"
          />
        </div>
      </div>

      <!-- CUSTOM FIELDS -->
      <div class="edit-section">
        <h5>Additional Requirements</h5>

        <% if (listing.customFields && listing.customFields.length > 0) { %>
          <% listing.customFields.forEach((field, index) => { %>

            <div class="row align-items-end custom-field mb-3">
              <div class="col-md-5">
                <label>Field Name</label>
                <input
                  type="text"
                  class="form-control"
                  name="job[customFields][<%= index %>][label]"
                  value="<%= field.label %>"
                  required
                />
              </div>

              <div class="col-md-5">
                <label>Field Value</label>
                <input
                  type="text"
                  class="form-control"
                  name="job[customFields][<%= index %>][value]"
                  value="<%= field.value %>"
                  required
                />
              </div>

              <div class="col-md-2">
                <button
                  type="button"
                  class="btn btn-danger w-100"
                  onclick="this.closest('.row').remove()"
                >
                  Remove
                </button>
              </div>
            </div>

          <% }) %>
        <% } else { %>
          <p class="text-muted">No additional requirements added.</p>
        <% } %>
      </div>

      <!-- SUBMIT -->
      <button class="update-btn w-100">
        Update Listing
      </button>

    </form>
  </div>
</div>