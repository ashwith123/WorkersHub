<% if (success && success.length) { %>
<div
  class="alert animation alert-success alert-dismissible fade show col-10 offset-1 col-sm-9 offset-sm-1 col-lg-6 offset-lg-2 mt-2"
  id="flash-message"
  role="alert"
>
  <%= success %>

  <button
    type="button"
    class="btn-close"
    data-bs-dismiss="alert"
    aria-label="Close"
  ></button>
</div>

<% } %> 

<% if (error && error.length) { %>
<div
  class="alert animation alert-danger alert-dismissible fade show col-10 offset-1 col-sm-9 offset-sm-1 col-lg-6 offset-lg-2 mt-2"
  role="alert"
>
  <%= error %>
  <button
    type="button"
    class="btn-close"
    data-bs-dismiss="alert"
    aria-label="Close"
  ></button>
</div>

<% } %>
<script>
  setTimeout(() => {
    document.querySelectorAll(".alert").forEach(el => {
      el.classList.remove("show");
      el.classList.add("fade");
      setTimeout(() => el.remove(), 500);
    });
  }, 3000);

  document.querySelectorAll(".btn-close").forEach(btn => {
    btn.addEventListener("click", () => {
      btn.closest(".alert").remove();
    });
  });
</script>